### theme = Nocturnal Winter
foreground = #c6d0f5
background = #130825
background-opacity = 0.9
selection-background = #402090
selection-foreground = #000000

cursor-color = #ff8800
cursor-text = #000000

font-family = Monofur Nerd Font Mono
font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-size = 16
font-thicken = true
font-thicken-strength = 128

#black
palette = 0=#504080
palette = 8=#504080
# red
palette = 1=#e00090
palette = 9=#e00090
# green
palette = 2=#74da10
palette = 10=#74da10
# yellow
palette = 3=#ff8800
palette = 11=#ff8800
# blue
palette = 4=#5035ff
palette = 12=#5035ff
# magenta
palette = 5=#ae00f8
palette = 13=#ae00f8
# cyan
palette = 6=#20ea98
palette = 14=#20ea98
# white
palette = 7=#9f9fda
palette = 15=#9f9fda

keybind = ctrl+k=goto_split:up
keybind = ctrl+j=goto_split:down
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right

keybind = ctrl+alt+k=new_split:up
keybind = ctrl+alt+j=new_split:down
keybind = ctrl+alt+h=new_split:left
keybind = ctrl+alt+l=new_split:right

keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

shell-integration-features = ssh-terminfo,ssh-env
